# Configuração do banco PostgreSQL + PostGIS (via Docker)
# Copie este arquivo para .env e ajuste se necessário:
#   cp .env.example .env  (Linux/Mac)
#   copy .env.example .env  (Windows)

POSTGRES_USER=crimemap
POSTGRES_PASSWORD=crimemap
POSTGRES_DB=crimemap

# URL usada pela aplicação (SQLAlchemy / psycopg2)
DATABASE_URL=postgresql+psycopg2://crimemap:crimemap@localhost:5432/crimemap

# Exigir login para acessar o painel (false = modo visitante aberto)
AUTH_REQUIRED=false
