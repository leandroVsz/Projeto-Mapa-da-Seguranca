[TEMPLATE]
# ============================================================
# CONFIGURAÇÃO DO PROJETO — copie para .env e ajuste
#   copy .env.example .env   (Windows CMD)
# ============================================================

# --- Opção A: PostgreSQL + PostGIS NA NUVEM (recomendado) ---
# Crie um banco gratuito em https://neon.tech (Postgres com PostGIS),
# copie a "Connection string" e cole abaixo, adicionando &sslmode=require.
# Exemplo:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@ep-xxx-pooler region.aws.neon.tech/neondb?sslmode=require
#
# Depois rode a carga (baixa os contornos GeoJSON e popula tudo):
#   python -m db.load_csv
#   python -m db.smoke_test

# --- Opção B: PostgreSQL local via Docker ---
#   docker compose up -d
DATABASE_URL=postgresql+psycopg2://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# Credenciais usadas apenas pelo docker-compose (Opção B)
POSTGRES_USER=crimemap
POSTGRES_PASSWORD=crimemap
POSTGRES_DB=crimemap

# Exigir login para acessar o painel (false = modo visitante aberto)
AUTH_REQUIRED=false

# --- Deploy no Streamlit Cloud (opcional) ---
# true = o app Streamlit sobe a API FastAPI no mesmo processo (porta 8000),
# sem precisar de servidor separado. Use true no deploy em nuvem.
EMBED_API=false
